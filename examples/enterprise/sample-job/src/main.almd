// The evaluation's sample job: an order report. It reads orders from the
// job's own input (/input/orders.csv) and prices from a directory the policy
// grants read-only (/data/catalog/prices.csv), writes /output/report.json and
// prints a one-line summary.
//
// The same module carries the misbehaviour an evaluator needs to see refused
// or stopped, chosen by its first argument: `probe` tries to reach what it
// was not granted, `spin` never ends, `grow` keeps allocating, `flood` keeps
// printing. Porta treats it as untrusted either way.
import env
import fs
import json
import value

fn price_of(prices: List[String], item: String) -> Int = {
  let row = list.find(prices, (line) => string.starts_with(line, item + ",")) ?? ""
  int.parse(string.trim(list.get(string.split(row, ","), 1) ?? "0")) ?? 0
}

effect fn report() -> Result[Unit, String] = {
  let orders = fs.read_text("/input/orders.csv")!
    |> string.split("\n") |> list.map((l) => string.trim(l)) |> list.filter((l) => l != "")
  let prices = fs.read_text("/data/catalog/prices.csv")! |> string.split("\n")
  var total = 0
  var lines = 0
  for order in list.drop(orders, 1) {
    let fields = string.split(order, ",")
    let item = string.trim(list.get(fields, 0) ?? "")
    let quantity = int.parse(string.trim(list.get(fields, 1) ?? "0")) ?? 0
    total = total + quantity * price_of(prices, item)
    lines = lines + 1
  }
  let summary = value.object([("orders", value.int(lines)), ("total_cents", value.int(total))])
  fs.write("/output/report.json", json.stringify(summary))!
  println("report: ${int.to_string(lines)} orders, total ${int.to_string(total)} cents")
  ok(())
}

// Each attempt is reported as "denied" or "ALLOWED"; the probe exits 0 only
// when every one was denied.
effect fn attempt(name: String, outcome: Result[String, String]) -> Bool = {
  let allowed = match outcome { ok(_) => true, err(_) => false }
  println("${name}: ${if allowed then "ALLOWED" else "denied"}")
  allowed
}

effect fn write_attempt(name: String, path: String) -> Bool = {
  let allowed = match fs.write(path, "x") { ok(_) => true, err(_) => false }
  println("${name}: ${if allowed then "ALLOWED" else "denied"}")
  allowed
}

effect fn probe() -> Result[Unit, String] = {
  var allowed = 0
  if attempt("read /etc/passwd", fs.read_text("/etc/passwd"))! then allowed = allowed + 1 else ()
  if attempt("read the worker's job file via /input/..", fs.read_text("/input/../job.json"))! then allowed = allowed + 1 else ()
  if attempt("read the host via /data/catalog/../..", fs.read_text("/data/catalog/../../etc/hosts"))! then allowed = allowed + 1 else ()
  if write_attempt("write into the read-only catalog", "/data/catalog/tampered.txt")! then allowed = allowed + 1 else ()
  if write_attempt("write into the read-only input", "/input/tampered.txt")! then allowed = allowed + 1 else ()
  if write_attempt("write outside every mount", "/tmp/escaped.txt")! then allowed = allowed + 1 else ()
  if allowed > 0 then err("a probe was allowed") else ok(())
}

effect fn spin() -> Result[Unit, String] = {
  var n = 0
  while true { n = n + 1 }
  ok(())
}

effect fn grow() -> Result[Unit, String] = {
  var chunks: List[String] = []
  var chunk = "0123456789abcdef"
  while true {
    chunk = chunk + chunk
    chunks = chunks + [chunk]
  }
  ok(())
}

effect fn flood() -> Result[Unit, String] = {
  while true { println("flooding the output with a line that keeps repeating forever") }
  ok(())
}

effect fn main() -> Result[Unit, String] = {
  let mode = list.get(env.args(), 0) ?? "report"
  match mode {
    "report" => report(),
    "probe" => probe(),
    "spin" => spin(),
    "grow" => grow(),
    "flood" => flood(),
    _ => err("unknown mode: ${mode}"),
  }
}
