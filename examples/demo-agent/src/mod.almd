import value
// Demo MCP agent for porta
// Reads length-prefixed JSON tool calls from stdin, writes JSON results to stdout.

import io
import json
import fs

effect fn main() -> Result[Unit, String] = {
  // Read 4-byte length prefix (little-endian)
  let b0 = bytes.get_or(io.read(io.stdin()!, 1)!, 0, -1)
  let b1 = bytes.get_or(io.read(io.stdin()!, 1)!, 0, -1)
  let b2 = bytes.get_or(io.read(io.stdin()!, 1)!, 0, -1)
  let b3 = bytes.get_or(io.read(io.stdin()!, 1)!, 0, -1)
  let len = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

  // Read JSON payload
  let payload = bytes.to_list(io.read_exact(io.stdin()!, len)!)
  let cmd = json.parse(bytes.to_string_lossy(bytes.from_list(payload)))!
  let tool = value.get_string(cmd, "tool") ?? ""
  let args = value.get(cmd, "arguments") ?? value.object([])

  let result = dispatch(tool, args)
  match result {
    ok(v) => println(json.stringify(v)),
    err(e) => println(json.stringify(value.object([("err", value.string(e))]))),
  }
  ok(())
}

effect fn dispatch(tool: String, args: Value) -> Result[Value, String] =
  match tool {
    "hello" => {
      let name = value.get_string(args, "name") ?? "world"
      ok(value.object([("ok", value.string("Hello, ${name}!"))]))
    },
    "add" => {
      let a = value.get_int(args, "a") ?? 0
      let b = value.get_int(args, "b") ?? 0
      ok(value.object([("ok", value.string(int.to_string(a + b)))]))
    },
    "read_file" => {
      let path = value.get_string(args, "path") ?? ""
      if path == "" then ok(value.object([("err", value.string("path is required"))]))
      else {
        match fs.read_text(path) {
          ok(content) => ok(value.object([("ok", value.string(content))])),
          err(error) => ok(value.object([("err", value.string(error))])),
        }
      }
    },
    "list_files" => {
      let dir = value.get_string(args, "directory") ?? "."
      let files = fs.list_dir(dir)!
      let file_list = files |> list.map(value.string) |> value.array
      ok(value.object([("ok", file_list)]))
    },
    "write_file" => {
      let path = value.get_string(args, "path") ?? ""
      let content = value.get_string(args, "content") ?? ""
      if path == "" then ok(value.object([("err", value.string("path is required"))]))
      else {
        match fs.write_text(path, content) {
          ok(_) => ok(value.object([("ok", value.string("wrote ${int.to_string(string.len(content))} bytes to ${path}"))])),
          err(error) => ok(value.object([("err", value.string(error))])),
        }
      }
    },
    _ => ok(value.object([("err", value.string("unknown tool: ${tool}"))])),
  }
