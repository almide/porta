import value
// Demo MCP agent for porta
// Reads length-prefixed JSON tool calls from stdin, writes JSON results to stdout.

import io
import json
import fs

effect fn main() -> Result[Unit, String] = {
  // Read 4-byte length prefix (little-endian)
  let b0 = io.read_byte()
  let b1 = io.read_byte()
  let b2 = io.read_byte()
  let b3 = io.read_byte()
  let len = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

  // Read JSON payload
  let payload = io.read_n_bytes(len)
  let cmd = json.parse(string.from_bytes(payload))!
  let tool = json.get_string(cmd, "tool") ?? ""
  let args = value.field(cmd, "arguments") ?? value.object([])

  let result = dispatch(tool, args)
  match result {
    ok(v) => println(json.stringify(v)),
    err(e) => println(json.stringify(value.object([("err", value.str(e))]))),
  }
  ok(())
}

effect fn dispatch(tool: String, args: Value) -> Result[Value, String] =
  match tool {
    "hello" => {
      let name = json.get_string(args, "name") ?? "world"
      ok(value.object([("ok", value.str("Hello, ${name}!"))]))
    },
    "add" => {
      let a = json.get_int(args, "a") ?? 0
      let b = json.get_int(args, "b") ?? 0
      ok(value.object([("ok", value.str(int.to_string(a + b)))]))
    },
    "read_file" => {
      let path = json.get_string(args, "path") ?? ""
      if path == "" then ok(value.object([("err", value.str("path is required"))]))
      else {
        match fs.read_text(path) {
          ok(content) => ok(value.object([("ok", value.str(content))])),
          err(error) => ok(value.object([("err", value.str(error))])),
        }
      }
    },
    "list_files" => {
      let dir = json.get_string(args, "directory") ?? "."
      let files = fs.list_dir(dir)!
      let file_list = files |> list.map(value.str) |> value.array
      ok(value.object([("ok", file_list)]))
    },
    "write_file" => {
      let path = json.get_string(args, "path") ?? ""
      let content = json.get_string(args, "content") ?? ""
      if path == "" then ok(value.object([("err", value.str("path is required"))]))
      else {
        match fs.write(path, content) {
          ok(_) => ok(value.object([("ok", value.str("wrote ${int.to_string(string.len(content))} bytes to ${path}"))])),
          err(error) => ok(value.object([("err", value.str(error))])),
        }
      }
    },
    _ => ok(value.object([("err", value.str("unknown tool: ${tool}"))])),
  }
