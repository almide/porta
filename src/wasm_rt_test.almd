import value
import json
import self.wasm_rt

// --- wt_http_request ---

test "wt_http_request: invalid URL" {
  let resp = wasm_rt.wt_http_request("GET", "http://invalid.invalid.invalid", "{}", "")!
  let parsed = json.parse(resp)
  match parsed {
    ok(v) => {
      let error = json.get_string(v, "error") ?? ""
      assert(string.len(error) > 0)
    },
    err(_) => assert(false),
  }
}

// --- wt_exec_command ---

test "wt_exec_command: echo" {
  let resp = wasm_rt.wt_exec_command("echo", "[\"hello\"]", ".")!
  let parsed = json.parse(resp)
  match parsed {
    ok(v) => {
      let exit_code = json.get_int(v, "exit_code") ?? -1
      assert_eq(exit_code, 0)
      let stdout = json.get_string(v, "stdout") ?? ""
      assert(string.len(stdout) > 0)
    },
    err(_) => assert(false),
  }
}

test "wt_exec_command: invalid command" {
  let resp = wasm_rt.wt_exec_command("nonexistent_command_xyz", "[]", ".")!
  let parsed = json.parse(resp)
  match parsed {
    ok(v) => {
      let error = json.get_string(v, "error") ?? ""
      assert(string.len(error) > 0)
    },
    err(_) => assert(false),
  }
}

// --- wt_inspect ---

test "wt_inspect: demo agent or missing" {
  let resp = wasm_rt.wt_inspect("examples/demo-agent/src/mod.wasm")
  let parsed = json.parse(resp)
  match parsed {
    ok(v) => {
      let error = json.get_string(v, "error") ?? ""
      if error != "" then assert(true) // file not found in CI — ok
      else {
        let imports = json.get_array(v, "imports") ?? []
        let exports = json.get_array(v, "exports") ?? []
        assert(list.len(imports) > 0)
        assert(list.len(exports) > 0)
      }
    },
    err(_) => assert(false),
  }
}

test "wt_inspect: invalid path" {
  let resp = wasm_rt.wt_inspect("nonexistent.wasm")
  let parsed = json.parse(resp)
  match parsed {
    ok(v) => {
      let error = json.get_string(v, "error") ?? ""
      assert(string.len(error) > 0)
    },
    err(_) => assert(false),
  }
}

// --- build_sandbox_profile ---

test "build_sandbox_profile: no dirs and no net means minimal sandbox" {
  let profile = wasm_rt.build_sandbox_profile([], [], "open")
  assert(string.contains(profile, "(deny file-write*)"))
  assert(not string.contains(profile, "(deny network-outbound)"))
  assert(string.contains(profile, ".ssh"))
}

test "build_sandbox_profile: dirs specified enables write restrictions" {
  let profile = wasm_rt.build_sandbox_profile(["."], [], "open")
  assert(string.contains(profile, "(deny file-write*)"))
}

test "build_sandbox_profile: allow_net restricts to listed ports" {
  let profile = wasm_rt.build_sandbox_profile(["."], ["*:443"], "open")
  assert(string.contains(profile, "(deny network-outbound)"))
  assert(not string.contains(profile, "(allow network-outbound (local udp))"))
  // Closing everything else must not close name resolution, or the granted
  // port is unusable by name.
  assert(string.contains(profile, "(allow network-outbound (literal \"/private/var/run/mDNSResponder\"))"))
}

test "build_sandbox_profile: no allow_net leaves the network open, resolver included" {
  let profile = wasm_rt.build_sandbox_profile(["."], [], "open")
  assert(not string.contains(profile, "network-outbound"))
}

test "build_sandbox_profile: allowed_net adds port-based TCP rules" {
  // sandbox-exec only supports * or localhost as host — port filtering only
  let profile = wasm_rt.build_sandbox_profile(["."], ["api.example.com:443"], "open")
  assert(string.contains(profile, "(allow network-outbound (remote tcp \"*:443\"))"))
}

test "build_sandbox_profile: wildcard port" {
  let profile = wasm_rt.build_sandbox_profile(["."], ["*:*"], "open")
  assert(string.contains(profile, "(allow network-outbound (remote tcp \"*:*\"))"))
}

test "build_sandbox_profile: :ro mount has no file-write rule" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace:ro"], [], "open")
  assert(not string.contains(profile, "(allow file-write* (subpath \"/workspace\"))"))
}

test "build_sandbox_profile: writable mount has file-write rule" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace"], [], "open")
  assert(string.contains(profile, "(allow file-write* (subpath \"/workspace\"))"))
}

test "build_sandbox_profile: cryptographic keys denied" {
  let profile = wasm_rt.build_sandbox_profile(["."], [], "open")
  assert(string.contains(profile, ".ssh"))
  assert(string.contains(profile, ".gnupg"))
  assert(not string.contains(profile, ".aws"))
  assert(not string.contains(profile, "Documents"))
}

// --- wt_getpid ---

test "wt_getpid: returns positive" {
  let pid = wasm_rt.wt_getpid()
  assert(pid > 0)
}

// --- wt_home_dir ---

test "wt_home_dir: returns non-empty" {
  let home = wasm_rt.wt_home_dir()
  assert(string.len(home) > 0)
}

test "proxy profile restricts egress to loopback without UDP or unix sockets" {
  let profile = wasm_rt.build_sandbox_profile([], ["127.0.0.1:42123"], "open")
  assert(string.contains(profile, "remote tcp \"localhost:42123\""))
  assert(not string.contains(profile, "*:42123"))
  assert(not string.contains(profile, "local udp"))
  assert(not string.contains(profile, "unix-socket"))
}

test "malformed network rules never grant unrestricted TCP" {
  let profile = wasm_rt.build_sandbox_profile([], ["example.com", "*:oops", "*:0"], "open")
  assert(string.contains(profile, "(deny network-outbound)"))
  // The resolver socket is reopened; no TCP destination is.
  assert(not string.contains(profile, "remote tcp"))
}

test "sandbox escapes injected profile expressions in mount paths" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace/\") (allow network*) ;"], ["*:443"], "open")
  assert(string.contains(profile, "\\\""))
  assert(not string.contains(profile, "subpath \"/private/var\""))
  assert(not string.contains(profile, "subpath \"/var\""))
}

// --- strict read policy ---

test "strict reads deny everything but the mounts and the platform's own dirs" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace"], [], "strict")
  assert(string.contains(profile, "(deny file-read*)"))
  assert(string.contains(profile, "(allow file-read* (subpath \"/workspace\"))"))
  // The loader reads the root directory entry before anything else.
  assert(string.contains(profile, "(allow file-read* (literal \"/\"))"))
  assert(string.contains(profile, "(allow file-read* (subpath \"/usr\"))"))
  // A home directory is exactly what this policy exists to close, so the open
  // policy's two key deny rules must not be the only thing standing between a
  // command and the rest of the disk.
  assert(not string.contains(profile, "(deny file-read-data"))
}

test "strict reads grant a read-only mount without granting writes to it" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace:ro"], [], "strict")
  assert(string.contains(profile, "(allow file-read* (subpath \"/workspace\"))"))
  assert(not string.contains(profile, "(allow file-write* (subpath \"/workspace\"))"))
}

test "strict reads escape injected profile expressions in mount paths" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace/\") (allow network*) ;"], [], "strict")
  assert(string.contains(profile, "\\\""))
}

// Only "strict" confines reads here; the request parser is what refuses a
// policy it does not recognise, so this layer must not silently confine or
// silently open on a name it has never seen.
test "the profile builder confines reads only for the strict policy" {
  let profile = wasm_rt.build_sandbox_profile(["/workspace"], [], "lenient")
  assert(not string.contains(profile, "(deny file-read*)"))
  assert(string.contains(profile, "(deny file-write*)"))
}

test "TOML parser preserves nested tables and rejects malformed config" {
  let parsed = json.parse(wasm_rt.wt_parse_toml("[sandbox]\nmounts = []\n[proxy]\nallow = [\"api.example.com\"]"))!
  let config = value.field(parsed, "value")!
  let empty: List[Value] = []
  assert_eq(json.get_array(value.field(config, "sandbox")!, "mounts"), some(empty))
  let invalid = json.parse(wasm_rt.wt_parse_toml("[broken"))!
  assert((json.get_string(invalid, "error") ?? "") != "")
}
