import value
// porta.toml configuration loader

import fs
import json
import process
import self.wasm_rt
import self.dispatch
import self.proxy
import env

type PortaConfig = {
  runtime_type: String,
  command: String,
  wasm_path: String,
  mounts: List[String],
  network: List[String],
  env_vars: List[dispatch.EnvVar],
  secrets: List[dispatch.EnvVar],
  profile: String,
  entry: String,
  step_limit: Int,
  max_memory: Int,
  restart: String,
  args: List[String],
  proxy_allow: List[String],
  proxy_deny: List[String],
  proxy_audit: String,
  credentials: List[proxy.Credential],
  env_pass: List[String],
  allow_unix: List[String],
  allow_bind: List[String],
  no_net: Bool,
  preset: String,
  deny_read: List[String],
  protect: List[String],
  deny_unix: List[String],
  timeout: Int,
  max_cpu: Int,
  max_procs: Int,
  max_file_size: Int,
  max_memory_mb: Int,
}

fn default_porta_config() -> PortaConfig = {
  runtime_type: "wasm",
  command: "",
  wasm_path: "",
  mounts: ["."],
  network: [],
  env_vars: [],
  secrets: [],
  profile: "",
  entry: "_start",
  step_limit: 0,
  max_memory: 0,
  restart: "no",
  args: [],
  proxy_allow: [],
  proxy_deny: [],
  proxy_audit: "",
  credentials: [],
  env_pass: [],
  allow_unix: [],
  allow_bind: [],
  no_net: false,
  preset: "",
  deny_read: [],
  protect: [],
  deny_unix: [],
  timeout: 0,
  max_cpu: 0,
  max_procs: 0,
  max_file_size: 0,
  max_memory_mb: 0,
}

effect fn load_porta_config(path: String) -> Result[PortaConfig, String] = {
  let parsed = json.parse(wasm_rt.wt_parse_toml(fs.read_text(path)!))!
  let error = value.get_string(parsed, "error") ?? ""
  if error != "" then err(error)
  else {
    let v = (value.as_object(parsed) |> result.flat_map((_) => option.to_result(value.get(parsed, "value"), "missing field 'value'")))!
    let rt = value.get(v, "runtime") ?? value.object([])
    let sb = value.get(v, "sandbox") ?? value.object([])
    let px = value.get(v, "proxy") ?? value.object([])
    ok({
      runtime_type: value.get_string(rt, "type") ?? "wasm",
      command: value.get_string(rt, "command") ?? "",
      wasm_path: value.get_string(rt, "wasm") ?? "",
      entry: value.get_string(rt, "entry") ?? "_start",
      mounts: strings_at(sb, "mounts", ["."]),
      network: strings_at(sb, "network", []),
      profile: value.get_string(sb, "profile") ?? "",
      step_limit: value.get_int(sb, "step-limit") ?? 0,
      max_memory: value.get_int(sb, "max-memory") ?? 0,
      restart: value.get_string(sb, "restart") ?? "no",
      env_vars: env_table(v),
      secrets: secret_table(v)!,
      args: strings_at(v, "args", []),
      proxy_allow: strings_at(px, "allow", []),
      proxy_deny: strings_at(px, "deny", []),
      proxy_audit: value.get_string(px, "audit") ?? "",
      credentials: credential_tables(v),
      env_pass: strings_at(sb, "env-pass", []),
      allow_unix: strings_at(sb, "unix", []),
      allow_bind: strings_at(sb, "bind", []),
      no_net: value.get_bool(sb, "no-net") ?? false,
      preset: value.get_string(sb, "preset") ?? "",
      deny_read: strings_at(sb, "deny-read", []),
      protect: strings_at(sb, "protect", []),
      deny_unix: strings_at(sb, "deny-unix", []),
      timeout: value.get_int(sb, "timeout") ?? 0,
      max_cpu: value.get_int(sb, "max-cpu") ?? 0,
      max_procs: value.get_int(sb, "max-procs") ?? 0,
      max_file_size: value.get_int(sb, "max-file-size") ?? 0,
      max_memory_mb: value.get_int(sb, "max-memory-mb") ?? 0,
    })
  }
}

// A TOML array of strings, or the default when the key is absent. Entries that
// are not strings are dropped rather than failing the whole configuration.
fn strings_at(table: Value, key: String, fallback: List[String]) -> List[String] =
  match value.get_array(table, key) {
    none => fallback,
    some(items) => items |> list.filter_map((item) => match value.as_string(item) { ok(s) => some(s), err(_) => none }),
  }

// [[credentials]] — name, from = { env = "VAR" } (default: the name itself),
// hosts = ["host[:443][/path]", ...]. A table without a name is left out.
fn credential_tables(v: Value) -> List[proxy.Credential] =
  (value.get_array(v, "credentials") ?? []) |> list.filter_map((t) => {
    let name = value.get_string(t, "name") ?? ""
    let from = value.get_string(value.get(t, "from") ?? value.object([]), "env") ?? name
    if name == "" then none else some({name: name, from_env: from, hosts: strings_at(t, "hosts", [])})
  })

// [env] — a plain key=value table.
fn env_table(v: Value) -> List[dispatch.EnvVar] = {
  let env_obj = value.get(v, "env") ?? value.object([])
  list.map(value.as_object(env_obj) ?? [], (kv) => kv.0) |> list.map((k) => {
    let e: dispatch.EnvVar = {key: k, val: value.get_string(env_obj, k) ?? ""}
    e
  })
}

// [secrets] — key="literal", or key={from-env = true} to read the host's
// environment. A key that is neither is left out rather than becoming empty.
effect fn secret_table(v: Value) -> Result[List[dispatch.EnvVar], String] = {
  let sec_obj = value.get(v, "secrets") ?? value.object([])
  ok(list.map(value.as_object(sec_obj) ?? [], (kv) => kv.0) |> list.filter_map((k) =>
    match value.get_string(sec_obj, k) {
      some(literal) => some({key: k, val: literal}),
      none =>
        if value.get_bool(value.get(sec_obj, k) ?? value.null(), "from-env") ?? false
        then some({key: k, val: env.get(k) ?? ""})
        else none,
    }))
}

fn generate_native_toml(command: String) -> String =
  "[runtime]\ntype = \"native\"\ncommand = \"" + command + "\"\n\n[sandbox]\n# Writable directories (the command can write here)\nmounts = [\".\"]\n# Add more as needed, e.g.:\n#   \"~/.config\"\n#   \"~/.cache\"\n#   \"~/Library\"\n#   \"/some/path:ro\"   (read-only)\n\n# Network restrictions (empty = all open, like Docker)\n# network = [\"*:443\"]   # HTTPS only\n# network = [\"*:80\", \"*:443\"]   # HTTP + HTTPS\n\n[env]\n\n[secrets]\n# key = \"value\"\n# key = { from-env = true }   # read from host environment\n"

fn generate_wasm_toml(wasm_path: String) -> String =
  "[runtime]\ntype = \"wasm\"\nwasm = \"" + wasm_path + "\"\nentry = \"_start\"\n\n[sandbox]\nmounts = [\".\"]\nprofile = \"full\"\n\n[env]\n\n[secrets]\n"
