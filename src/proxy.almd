import value
// HTTPS CONNECT proxy: hostname allow/deny enforced in the Rust bridge.
// Almide owns config shape and lifecycle; the accept loop runs in a native thread.

import json
import process
import self.wasm_rt
import self.dispatch
import self.util
import porta_sandbox

// The proxy's types and lifecycle are the sandbox package's
// (sandbox/src/mod.almd); the names porta's own code uses for them stay here.
type Credential = porta_sandbox.Credential

type ProxyConfig = porta_sandbox.ProxyConfig

type ProxyHandle = porta_sandbox.ProxyHandle

fn empty_config() -> ProxyConfig = porta_sandbox.no_proxy()

fn is_enabled(c: ProxyConfig) -> Bool = porta_sandbox.proxy_enabled(c)

fn validate(c: ProxyConfig) -> Result[Unit, String] = porta_sandbox.proxy_valid(c)

effect fn start(c: ProxyConfig) -> Result[ProxyHandle, String] = porta_sandbox.proxy_open(c)

effect fn stop(h: ProxyHandle) -> Result[Unit, String] = porta_sandbox.proxy_close(h)

fn endpoint(h: ProxyHandle) -> String = porta_sandbox.proxy_endpoint(h)

fn sandbox_net_rule(h: ProxyHandle) -> String = porta_sandbox.proxy_net_rule(h)

// --credential NAME=HOST[,HOST...]: the host variable NAME, handed in as a
// placeholder and put on for requests to these hosts (`host[:443][/path]`).
fn parse_credential(text: String) -> Credential? =
  match util.split_at_eq(text) {
    some(kv) => some({name: kv.key, from_env: kv.key,
      hosts: string.split(kv.val, ",") |> list.map(string.trim) |> list.filter((h) => h != "")}),
    none => none,
  }

// [[credentials]] tables for a saved policy: where each credential goes and
// which variable it is read from, never its value.
fn toml_tables(credentials: List[Credential]) -> List[String] =
  credentials |> list.flat_map((c) =>
    ["", "[[credentials]]", "name = " + util.toml_quote(c.name), "from = { env = " + util.toml_quote(c.from_env) + " }",
     "hosts = " + util.toml_strings(c.hosts)])
