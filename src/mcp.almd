import value
// MCP Protocol State Machine
//
// This file is the session: what a request is routed to, and what the reply
// does to the server. The work behind a method lives beside it —
// `mcp_builtins` for the tools porta serves itself, `mcp_content` for
// resources and prompts.

import json
import self.jsonrpc
import self.manifest
import self.dispatch
import self.observability
import self.mcp_builtins
import self.mcp_content

type McpState =
  | Initializing
  | Ready
  | Closed

type McpServer = {
  state: McpState,
  manifest: manifest.Manifest,
  config: dispatch.InstanceConfig,
  metrics: observability.Metrics,
}

// What every handler answers: the session as it now stands, and the reply to
// write, if the request called for one.
type Reply = { server: McpServer, response: Option[String] }

fn new_server(m: manifest.Manifest, config: dispatch.InstanceConfig) -> McpServer =
  {state: Initializing, manifest: m, config: config, metrics: observability.empty_metrics()}

// A reply that leaves the session untouched, which is every method but
// `initialize` and a tool call.
fn answer(server: McpServer, response: String) -> Result[Reply, String] =
  ok({server: server, response: some(response)})

fn refuse(server: McpServer, req: jsonrpc.JsonRpcRequest, code: Int, reason: String) -> Result[Reply, String] =
  answer(server, jsonrpc.make_error_response(req.id, code, reason))

// --- Handle a single request ---

effect fn handle_request(server: McpServer, req: jsonrpc.JsonRpcRequest) -> Result[Reply, String] =
  if string.starts_with(req.method, "notifications/") and req.method != "notifications/initialized" then
    ok({server: server, response: none})
  else match req.method {
    "initialize" => handle_initialize(server, req),
    "notifications/initialized" => ok({server: {...server, state: Ready}, response: none}),
    "tools/list" => handle_tools_list(server, req),
    "tools/call" => handle_tools_call(server, req),
    "resources/list" => answer(server, mcp_content.resources_list(server.manifest, req)),
    "resources/read" => answer(server, mcp_content.resources_read(server.manifest, server.config, req)!),
    "prompts/list" => answer(server, mcp_content.prompts_list(server.manifest, req)),
    "prompts/get" => answer(server, mcp_content.prompts_get(server.manifest, server.config, req)!),
    "ping" => answer(server, jsonrpc.make_response(req.id, value.object([]))),
    _ => refuse(server, req, -32601, "Method not found: ${req.method}"),
  }

effect fn handle_initialize(server: McpServer, req: jsonrpc.JsonRpcRequest) -> Result[Reply, String] = {
  let result = value.object([
    ("protocolVersion", value.str("2025-03-26")),
    ("serverInfo", value.object([
      ("name", value.str("porta/${server.manifest.name}")),
      ("version", value.str(server.manifest.version)),
    ])),
    ("capabilities", value.object([
      ("tools", value.object([("listChanged", value.bool(false))])),
      ("resources", value.object([("listChanged", value.bool(false))])),
      ("prompts", value.object([("listChanged", value.bool(false))])),
    ])),
  ])
  answer(server, jsonrpc.make_response(req.id, result))
}

effect fn handle_tools_list(server: McpServer, req: jsonrpc.JsonRpcRequest) -> Result[Reply, String] = {
  let module_tools = server.manifest.tools |> list.map((tool) =>
    value.object([
      ("name", value.str(tool.name)),
      ("description", value.str(tool.description)),
      ("inputSchema", tool.input_schema),
    ])
  )
  let result = value.object([("tools", value.array(module_tools + mcp_builtins.declarations()))])
  answer(server, jsonrpc.make_response(req.id, result))
}

// --- Tool calls ---

effect fn handle_tools_call(server: McpServer, req: jsonrpc.JsonRpcRequest) -> Result[Reply, String] = {
  let tool_name = json.get_string(req.params, "name") ?? ""
  let arguments = value.field(req.params, "arguments") ?? value.object([])
  match mcp_builtins.builtin(tool_name, server.config) {
    some(tool) => call_builtin(server, req, tool, arguments),
    none => call_module_tool(server, req, tool_name, arguments),
  }
}

// A builtin runs only once both of its guards pass; which guards those are is
// the builtin's own declaration, not this call site's business.
effect fn call_builtin(server: McpServer, req: jsonrpc.JsonRpcRequest, tool: mcp_builtins.Builtin, arguments: Value) -> Result[Reply, String] =
  match mcp_builtins.refusal(tool, server.config, arguments) {
    some(reason) => refuse(server, req, -32602, reason),
    none => {
      let result = mcp_builtins.run(tool, server.config, arguments)!
      answer(server, jsonrpc.make_response(req.id, result))
    },
  }

effect fn call_module_tool(server: McpServer, req: jsonrpc.JsonRpcRequest, tool_name: String, arguments: Value) -> Result[Reply, String] =
  match server.manifest.tools |> list.find((t) => t.name == tool_name) {
    none => {
      let available = server.manifest.tools |> list.map((t) => t.name) |> string.join(", ")
      refuse(server, req, -32602, "Unknown tool: '${tool_name}'. Available tools: ${available}")
    },
    some(_t) => {
      let tool_result = dispatch.dispatch_tool(server.config, tool_name, json.stringify(arguments))!
      let success = match tool_result.exit_code { some(c) => c == 0, none => true }
      // Diagnostic log to stderr
      eprintln(observability.format_tool_log(tool_name, tool_result.metrics.steps, tool_result.metrics.memory_pages, success))
      let metrics = observability.merge_tool_call(server.metrics, tool_result.metrics.steps, tool_result.metrics.memory_pages)
      let result = tool_response(tool_result.stdout, success)
      ok({server: {...server, metrics: metrics}, response: some(jsonrpc.make_response(req.id, result))})
    },
  }

// Legacy single-key Result envelopes are unwrapped. Multi-field results must
// remain intact: {ok:true,json:"..."} carries more than its status flag.
fn tool_response(output: String, success: Bool) -> Value = {
  let rendered = match json.parse(output) {
    ok(v) => rendered_envelope(v, output, success),
    err(_) => {text: output, failed: not success},
  }
  value.object([
    ("content", value.array([value.object([
      ("type", value.str("text")), ("text", value.str(rendered.text)),
    ])])),
    ("isError", value.bool(rendered.failed)),
  ])
}

fn rendered_envelope(v: Value, output: String, success: Bool) -> {text: String, failed: Bool} = {
  let ok_value = value.field(v, "ok")
  let err_value = value.field(v, "err")
  if list.len(value.keys(v)) != 1 then {
    let status_failed = json.stringify(ok_value ?? value.null()) == "false"
    let has_error = match err_value { ok(_) => true, err(_) => false }
    {text: output, failed: not success or status_failed or has_error}
  }
  else match ok_value {
    ok(ov) => {text: value.as_string(ov) ?? json.stringify(ov), failed: not success},
    err(_) => match err_value {
      ok(ev) => {text: value.as_string(ev) ?? json.stringify(ev), failed: true},
      err(_) => {text: output, failed: not success},
    },
  }
}

// --- Main loop ---

effect fn serve_loop(initial: McpServer) -> Result[Unit, String] = {
  var server = initial
  var running = true
  while running {
    let msg = jsonrpc.read_message()!
    match msg {
      none => { running = false },
      some(req) => {
        let result = handle_request(server, req)!
        match result.response {
          some(resp) => { jsonrpc.write_message(resp)! },
          none => (),
        }
        server = result.server
      },
    }
  }
  ok(())
}
