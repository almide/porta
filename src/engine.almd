import value
// Engine: WASM/native execution, MCP serve, validate, inspect

import fs
import json
import self.cli
import self.ops
import self.dispatch
import self.sandbox
import self.observability
import self.util
import self.wasm_rt
import self.manifest
import self.mcp
import self.proxy

// --- Serve ---

effect fn serve(opts: cli.Options) -> Result[Unit, String] = {
  let manifest_path = if opts.manifest_path != "" then opts.manifest_path
    else string.replace(opts.path, ".wasm", ".manifest.json")
  let has_manifest = fs.exists(manifest_path)
  let m = if has_manifest then manifest.load_manifest(manifest_path)!
    else {
      let export_tools = exported_functions(opts.path)!
        |> list.map((name) => {
          let tool: manifest.ToolDef = {name: name, description: name, input_schema: value.object([])}
          tool
        })
      let m: manifest.Manifest = {
        schema_version: "1.0",
        name: "agent",
        version: util.version(),
        description: "",
        capabilities: [],
        tools: export_tools,
        resources: [],
        prompts: [],
        wasi_imports: [],
        entry: "_start",
      }
      m
    }
  let caps = util.resolve_serve_caps(opts.profile, m.capabilities)
  let env = cli.resolve_env(opts)!
  let config = cli.build_config(opts.path, opts, caps, env)
  let server = mcp.new_server(m, config)
  mcp.serve_loop(server)
}

// --- Run ---

effect fn run_wasm(opts: cli.Options) -> Result[Unit, String] =
  if opts.detach then ops.run_detached(opts)
  else if opts.daemon_id != "" then ops.run_as_daemon(opts)
  else run_foreground(opts)

effect fn run_foreground(opts: cli.Options) -> Result[Unit, String] = {
  let caps = cli.resolve_run_caps(opts)!
  let env = cli.resolve_env(opts)!
  let config = cli.build_config(opts.path, opts, caps, env)
  let result = dispatch.run_instance(config)!
  if string.len(result.stdout) > 0 then println(result.stdout) else ()
  if string.len(result.stderr) > 0 then eprintln(result.stderr) else ()
  eprintln(observability.format_summary(result.metrics))
  ok(())
}

// --- Native sandbox execution ---

fn proxy_config(opts: cli.Options) -> proxy.ProxyConfig =
  {allow: opts.proxy_allow, deny: opts.proxy_deny, audit_path: opts.proxy_audit}

// Runs a native command under the policy the options describe and returns
// the command's own exit code, so the caller can exit with it.
effect fn run_native(opts: cli.Options) -> Result[Int, String] = {
  let proxy_cfg = proxy_config(opts)
  if proxy.is_enabled(proxy_cfg) then run_native_proxied(opts, proxy_cfg)
  else run_native_direct(opts)
}

// The request every native entry point builds: the command, its mounts and
// its policy, with `net` and `env` supplied by the caller because proxy mode
// replaces both.
effect fn native_request(opts: cli.Options, net: List[String], proxy_env: List[dispatch.EnvVar], proxied: Bool) -> Result[dispatch.ExecRequest, String] = {
  let request: dispatch.ExecRequest = {
    cmd: opts.path,
    args: opts.wasm_args,
    dirs: opts.preopen_dirs,
    net: net,
    env: cli.resolve_env(opts)! + opts.secrets + proxy_env,
    cwd: dispatch.first_mount(opts.preopen_dirs),
    read_policy: opts.read_policy,
    proxy: proxied,
    allow_root: opts.allow_root,
    bind: opts.allow_bind,
    unix: opts.allow_unix,
    timeout: opts.timeout,
    max_cpu: opts.max_cpu,
    max_procs: opts.max_procs,
    max_file_size: opts.max_file_size,
  }
  ok(request)
}

// What a supervised run reported: the command's exit code, or the reason the
// run was refused before it began.
fn supervised_exit(reply_json: String) -> Result[Int, String] = {
  let reply = json.parse(reply_json)!
  let error = json.get_string(reply, "error") ?? ""
  if error != "" then err(error)
  else ok(json.get_int(reply, "exit_code") ?? 1)
}

// The policy in words, without running anything. Proxy mode is described
// with a placeholder endpoint: the proxy is not started for an explanation.
effect fn explain_native(opts: cli.Options) -> Result[Unit, String] = {
  let proxied = proxy.is_enabled(proxy_config(opts))
  let net = if proxied then ["127.0.0.1:1"] else opts.allow_net
  if opts.save_path != "" then {
    fs.write(opts.save_path, cli.policy_toml(opts))!
    println("saved this policy to ${opts.save_path}; commit it and re-run with 'porta up'")
    ok(())
  }
  else {
    let request = native_request(opts, net, [], proxied)!
    let request_json = dispatch.exec_request_json(request)
    println(if opts.json then wasm_rt.wt_sandbox_explain_json(request_json) else wasm_rt.wt_sandbox_explain(request_json))
    ok(())
  }
}

// porta stays as the parent rather than becoming the command: it is then
// still there when the command exits to say what the sandbox refused.
effect fn run_native_direct(opts: cli.Options) -> Result[Int, String] = {
  let request = native_request(opts, opts.allow_net, [], false)!
  supervised_exit(wasm_rt.wt_exec_supervised(dispatch.exec_request_json(request)))
}

// Proxy mode: start CONNECT proxy, constrain net to the proxy port only,
// inject HTTP(S)_PROXY, run supervised so the proxy thread stays alive.
// Any user-supplied --allow-net is intentionally ignored in this mode:
// the proxy is the only permitted egress.
effect fn run_native_proxied(opts: cli.Options, proxy_cfg: proxy.ProxyConfig) -> Result[Int, String] = {
  if list.len(opts.allow_net) > 0 then
    eprintln("[porta] --allow-net is ignored when --proxy-allow/--proxy-deny is set; proxy is the only egress")
  else ()

  let h = proxy.start(proxy_cfg)!
  eprintln("[porta] proxy listening on 127.0.0.1:${int.to_string(h.port)}")

  // Env: inject HTTP(S)_PROXY so well-behaved clients route through the proxy.
  // Raw sockets bypassing HTTPS_PROXY will be blocked by the sandbox net policy.
  let endpoint = proxy.endpoint(h)
  // Node's fetch ignores the proxy variables unless told to honour them.
  let proxy_env: List[dispatch.EnvVar] = [
    {key: "HTTP_PROXY", val: endpoint},
    {key: "HTTPS_PROXY", val: endpoint},
    {key: "http_proxy", val: endpoint},
    {key: "https_proxy", val: endpoint},
    {key: "NODE_USE_ENV_PROXY", val: "1"},
  ]
  // Net: strictly the proxy port. Anything else must be blocked at the OS level.
  let request = native_request(opts, [proxy.sandbox_net_rule(h)], proxy_env, true)!
  let reply = wasm_rt.wt_exec_supervised(dispatch.exec_request_json(request))
  proxy.stop(h)!
  supervised_exit(reply)
}

// --- Validate ---

effect fn validate(opts: cli.Options) -> Result[Unit, String] = {
  println("Validating: ${opts.path}")
  let caps = validation_capabilities(opts)!
  let wasi_imports = wasi_imports_of(opts.path)!

  println("  WASI imports: ${int.to_string(list.len(wasi_imports))}")
  for imp in wasi_imports {
    let name = json.get_string(imp, "name") ?? ""
    println("    ${name}${import_status(caps, name)}")
  }

  let denied = wasi_imports |> list.filter((imp) => is_denied(caps, json.get_string(imp, "name") ?? ""))
  if list.len(denied) > 0 then {
    let first_name = json.get_string(list.get(denied, 0) ?? value.object([]), "name") ?? ""
    println("  Result: FAIL — capability denied for '${first_name}'")
  }
  else println("  Result: PASS")
  ok(())
}

// What this run would be allowed: an explicit --profile first, then the
// manifest beside the module, and a full profile only when neither says.
effect fn validation_capabilities(opts: cli.Options) -> Result[sandbox.CapabilitySet, String] = {
  if opts.profile != "" then ok(named_profile(opts.profile))
  else {
    let manifest_path = if opts.manifest_path != "" then opts.manifest_path
      else string.replace(opts.path, ".wasm", ".manifest.json")
    if not fs.exists(manifest_path) then ok(sandbox.profile_full())
    else {
      let m = manifest.load_manifest(manifest_path)!
      if list.len(m.capabilities) > 0 then ok(sandbox.from_manifest(m.capabilities))
      else ok(sandbox.profile_full())
    }
  }
}

// "ai-agent" is both a name and the default for an unrecognised one.
fn named_profile(name: String) -> sandbox.CapabilitySet =
  match name {
    "worker" => sandbox.profile_worker(),
    "full" => sandbox.profile_full(),
    _ => sandbox.profile_ai_agent(),
  }

// The functions a module exports that a caller could invoke as a tool. The
// runtime's own entry points are not tools, so they are left out. Read the
// same way `validate` and `inspect` read a module: through the engine that
// will run it, never through a second parser that could disagree with it.
effect fn exported_functions(path: String) -> Result[List[String], String] = {
  let info = json.parse(wasm_rt.wt_inspect(path))!
  let error = json.get_string(info, "error") ?? ""
  if error != "" then err(error)
  else ok(json.get_array(info, "exports") ?? []
    |> list.filter((exp) => json.get_string(exp, "kind") ?? "" == "func")
    |> list.filter_map((exp) => match json.get_string(exp, "name") {
      some(name) => if name == "_start" or name == "__alloc" or name == "memory" then none else some(name),
      none => none,
    }))
}

// Imports are read from the module without instantiating it.
effect fn wasi_imports_of(path: String) -> Result[List[Value], String] = {
  let info = json.parse(wasm_rt.wt_inspect(path))!
  let all_imports = json.get_array(info, "imports") ?? []
  ok(all_imports |> list.filter((imp) => json.get_string(imp, "module") ?? "" == "wasi_snapshot_preview1"))
}

fn is_denied(caps: sandbox.CapabilitySet, name: String) -> Bool =
  match sandbox.required_capability(name) {
    none => false,
    some(cap) => not sandbox.has_capability(caps, cap),
  }

fn import_status(caps: sandbox.CapabilitySet, name: String) -> String =
  match sandbox.required_capability(name) {
    none => "  ok",
    some(cap) =>
      if sandbox.has_capability(caps, cap) then "  ok"
      else "  DENIED (requires ${sandbox.cap_name(cap)})",
  }

// --- Inspect ---

effect fn inspect(path: String) -> Result[Unit, String] = {
  let info_json = wasm_rt.wt_inspect(path)
  let info = json.parse(info_json)!
  let error = json.get_string(info, "error") ?? ""
  if error != "" then err(error)
  else {
    let imports = json.get_array(info, "imports") ?? []
    let exports = json.get_array(info, "exports") ?? []
    let memories = json.get_array(info, "memories") ?? []

    let component = json.get_bool(info, "component") ?? false
    let wasi = json.get_string(info, "wasi") ?? "0.2"
    println((if component then "Component (WASI ${wasi}): " else "Module: ") + path)
    println("  Imports:   ${int.to_string(list.len(imports))}")
    println("  Exports:   ${int.to_string(list.len(exports))}")
    println("  Memories:  ${int.to_string(list.len(memories))}")

    println("")
    println("Imports:")
    for entry in list.enumerate(imports) {
      let (idx, imp) = entry
      let mod_name = json.get_string(imp, "module") ?? ""
      let name = json.get_string(imp, "name") ?? ""
      let kind = json.get_string(imp, "kind") ?? ""
      // A component's import is a whole interface: no function name follows.
      let shown = if name == "" then mod_name else "${mod_name}.${name}"
      println("  [${int.to_string(idx)}] ${shown} (${kind})")
    }

    println("")
    println("Exports:")
    for exp in exports {
      let name = json.get_string(exp, "name") ?? ""
      let kind = json.get_string(exp, "kind") ?? ""
      println("  ${name} (${kind})")
    }

    ok(())
  }
}
