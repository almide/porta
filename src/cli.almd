// CLI types, argument parsing, and shared configuration builders

import fs
import process
import self.dispatch
import self.sandbox
import self.manifest
import self.util

// --- Options ---

type Options = {
  path: String,
  entry: String,
  step_limit: Int,
  max_memory_pages: Int,
  restart: String,
  profile: String,
  manifest_path: String,
  env_vars: List[dispatch.EnvVar],
  env_file: String,
  secrets: List[dispatch.EnvVar],
  detach: Bool,
  daemon_id: String,
  wasm_args: List[String],
  preopen_dirs: List[String],
  allow_net: List[String],
  allow_exec: List[String],
  proxy_allow: List[String],
  proxy_deny: List[String],
  proxy_audit: String,
  read_policy: String,
  allow_root: Bool,
  // Host variables copied into the child by name. The child's environment
  // starts empty apart from the few a command needs to run.
  env_pass: List[String],
  // Unix sockets the child may connect to although they hold a credential
  // agent: the SSH agent, gpg-agent, a container runtime.
  allow_unix: List[String],
  // TCP ports the child may listen on once --allow-net closes the network.
  allow_bind: List[String],
  // Seconds the command may run before porta kills it and everything it
  // started. 0 means no limit.
  timeout: Int,
  // Per-process ceilings set with setrlimit and inherited by everything the
  // command starts: CPU seconds, processes of this user, file size in MiB.
  // 0 leaves one unset.
  max_cpu: Int,
  max_procs: Int,
  max_file_size: Int,
  // Resident memory in MiB for the whole run, a cgroup v2 ceiling set through
  // the systemd user manager on Linux. 0 leaves it unset; refused elsewhere.
  max_memory_mb: Int,
  // Emit machine-readable JSON instead of prose, for `explain` and `check`.
  json: Bool,
  // Where `explain --save` writes a porta.toml of the policy in these flags.
  save_path: String,
}

fn default_options() -> Options = {
  path: "",
  entry: "_start",
  step_limit: 0,
  max_memory_pages: 0,
  restart: "no",
  profile: "",
  manifest_path: "",
  env_vars: [],
  env_file: "",
  secrets: [],
  detach: false,
  daemon_id: "",
  wasm_args: [],
  preopen_dirs: [],
  allow_net: [],
  allow_exec: [],
  proxy_allow: [],
  proxy_deny: [],
  proxy_audit: "",
  read_policy: "open",
  allow_root: false,
  env_pass: [],
  allow_unix: [],
  allow_bind: [],
  timeout: 0,
  max_cpu: 0,
  max_procs: 0,
  max_file_size: 0,
  max_memory_mb: 0,
  json: false,
  save_path: "",
}

// One argument applied. `consumed` is how many arguments it took: two for an
// option with a value, one for a flag or a bare word.
type ParsedOption = { opts: Options, consumed: Int }

fn parse_options(args: List[String], idx: Int, opts: Options) -> Result[Options, String] =
  if idx >= list.len(args) then ok(opts)
  else {
    let arg = list.get(args, idx) ?? ""
    // Everything after `--` belongs to the program being run, not to porta.
    if arg == "--" then ok({...opts, wasm_args: list.drop(args, idx + 1)})
    else {
      let step = apply_option(opts, arg, list.get(args, idx + 1) ?? "")!
      parse_options(args, idx + step.consumed, step.opts)
    }
  }

fn apply_option(opts: Options, arg: String, next: String) -> Result[ParsedOption, String] =
  ok(match arg {
    "--entry" => valued({...opts, entry: next}),
    "--step-limit" => valued({...opts, step_limit: util.parse_int(next)}),
    "--max-memory" => valued({...opts, max_memory_pages: util.parse_int(next)}),
    "--restart" => valued({...opts, restart: next}),
    "--profile" => valued({...opts, profile: next}),
    "--manifest" => valued({...opts, manifest_path: next}),
    "-e" => valued(with_env(opts, next)),
    "--env" => valued(with_env(opts, next)),
    "--env-file" => valued({...opts, env_file: next}),
    "--secret" => valued(with_secret(opts, next)),
    "-v" => valued({...opts, preopen_dirs: opts.preopen_dirs + [next]}),
    "--allow-net" => valued({...opts, allow_net: opts.allow_net + [next]}),
    "--allow-exec" => valued({...opts, allow_exec: opts.allow_exec + string.split(next, ",")}),
    "--proxy-allow" => valued({...opts, proxy_allow: opts.proxy_allow + string.split(next, ",")}),
    "--proxy-deny" => valued({...opts, proxy_deny: opts.proxy_deny + string.split(next, ",")}),
    "--proxy-audit" => valued({...opts, proxy_audit: next}),
    "--read-policy" => valued({...opts, read_policy: next}),
    "--allow-root" => flag({...opts, allow_root: true}),
    "--env-pass" => valued({...opts, env_pass: opts.env_pass + string.split(next, ",")}),
    "--allow-unix" => valued({...opts, allow_unix: opts.allow_unix + [next]}),
    "--allow-bind" => valued({...opts, allow_bind: opts.allow_bind + [next]}),
    "--timeout" => valued({...opts, timeout: util.parse_int(next)}),
    "--max-cpu" => valued({...opts, max_cpu: util.parse_int(next)}),
    "--max-procs" => valued({...opts, max_procs: util.parse_int(next)}),
    "--max-file-size" => valued({...opts, max_file_size: util.parse_int(next)}),
    "--max-memory-mb" => valued({...opts, max_memory_mb: util.parse_int(next)}),
    "--json" => flag({...opts, json: true}),
    "--save" => valued({...opts, save_path: next}),
    "-d" => flag({...opts, detach: true}),
    "--detach" => flag({...opts, detach: true}),
    "--_daemon" => valued({...opts, daemon_id: next}),
    _ => unrecognized(opts, arg)!,
  })

fn valued(opts: Options) -> ParsedOption = {opts: opts, consumed: 2}
fn flag(opts: Options) -> ParsedOption = {opts: opts, consumed: 1}

// The first bare word is the target. Anything else porta does not recognise is
// an error, never silently dropped: `porta run echo hello` used to run `echo`
// with no arguments and exit 0, and a user has no way to tell that from a
// working command that printed nothing. Arguments for the target go after `--`.
fn unrecognized(opts: Options, arg: String) -> Result[ParsedOption, String] =
  if string.starts_with(arg, "-") then
    err("unknown option ${arg}; 'porta help <command>' lists the options porta takes, "
      + "and an option for the command itself goes after --")
  else if opts.path == "" then ok({opts: {...opts, path: arg}, consumed: 1})
  else
    err("unexpected argument '${arg}': porta takes options here, and the command's own "
      + "arguments go after --, as in: porta run ${opts.path} [options] -- ${arg}")

// -e, --env and --secret take key=value; a value without '=' adds nothing.
fn with_env(opts: Options, text: String) -> Options =
  match util.split_at_eq(text) {
    some(kv) => {...opts, env_vars: opts.env_vars + [kv]},
    none => opts,
  }

fn with_secret(opts: Options, text: String) -> Options =
  match util.split_at_eq(text) {
    some(kv) => {...opts, secrets: opts.secrets + [kv]},
    none => opts,
  }

// --- Environment resolution ---

effect fn load_env_file(path: String) -> Result[List[dispatch.EnvVar], String] = {
  let content = fs.read_text(path)!
  let lines = util.split_lines(string.to_bytes(content), 0, 0, [])
  ok(lines
    |> list.filter((line) => string.len(string.trim(line)) > 0 and not string.starts_with(string.trim(line), "#"))
    |> list.filter_map((line) => util.split_at_eq(string.trim(line))))
}

effect fn resolve_env(opts: Options) -> Result[List[dispatch.EnvVar], String] = {
  let file_env = if opts.env_file != "" then load_env_file(opts.env_file)!
    else []
  // --env-pass copies a host variable by name; one the host does not have
  // adds nothing rather than an empty value.
  let passed = opts.env_pass |> list.filter_map((name) =>
    match process.env(name) {
      some(val) => some({key: name, val: val}),
      none => none,
    })
  // CLI --env overrides file values (dedup: keep last occurrence per key)
  let combined = passed + file_env + opts.env_vars
  ok(dedup_env(combined, 0, []))
}

fn dedup_env(vars: List[dispatch.EnvVar], idx: Int, acc: List[dispatch.EnvVar]) -> List[dispatch.EnvVar] =
  if idx >= list.len(vars) then acc
  else {
    let head = list.get(vars, idx) ?? {key: "", val: ""}
    let tail = list.drop(vars, idx + 1)
    let rest_has_key = tail |> list.any((e) => e.key == head.key)
    if rest_has_key then dedup_env(vars, idx + 1, acc)
    else dedup_env(vars, idx + 1, acc + [head])
  }

// --- Capability resolution (manifest-aware) ---

effect fn resolve_run_caps(opts: Options) -> Result[sandbox.CapabilitySet, String] = {
  let manifest_path = if opts.manifest_path != "" then opts.manifest_path
    else string.replace(opts.path, ".wasm", ".manifest.json")
  if fs.exists(manifest_path) then {
    let m = manifest.load_manifest(manifest_path)!
    ok(util.resolve_serve_caps(opts.profile, m.capabilities))
  }
  else ok(util.resolve_caps(opts.profile, []))
}

// --- Config builder ---

fn build_config(wasm_path: String, opts: Options, caps: sandbox.CapabilitySet, env: List[dispatch.EnvVar]) -> dispatch.InstanceConfig = {
  let config = dispatch.default_config(wasm_path, caps)
  {
    ...config,
    entry: opts.entry,
    step_limit: opts.step_limit,
    max_memory_pages: opts.max_memory_pages,
    restart_policy: dispatch.parse_restart_policy(opts.restart),
    env_vars: env,
    secrets: opts.secrets,
    wasm_args: opts.wasm_args,
    preopen_dirs: opts.preopen_dirs,
    allowed_commands: opts.allow_exec,
    allowed_hosts: opts.allow_net,
  }
}

// --- Policy capture ---

// A TOML basic string: backslash and double-quote escaped so a path holding
// either stays valid TOML rather than closing the string early.
fn toml_quote(s: String) -> String =
  "\"" + string.replace(string.replace(s, "\\", "\\\\"), "\"", "\\\"") + "\""

fn toml_strings(items: List[String]) -> String =
  "[" + string.join(items |> list.map(toml_quote), ", ") + "]"

fn line_when(present: Bool, line: String) -> List[String] =
  if present then [line] else []

// A porta.toml capturing the sandbox policy in `opts`, so an invocation a user
// converged on can be committed and re-run with `porta up`. Only the policy is
// written: -e values and secrets are left out on purpose, since a committed
// file is the wrong place for them.
fn policy_toml(opts: Options) -> String = {
  let mounts = if list.len(opts.preopen_dirs) > 0 then opts.preopen_dirs else ["."]
  let proxy_on = list.len(opts.proxy_allow) > 0 or list.len(opts.proxy_deny) > 0 or opts.proxy_audit != ""
  let has_env = list.len(opts.env_vars) > 0 or list.len(opts.secrets) > 0
  let lines =
    ["[runtime]", "type = \"native\"", "command = " + toml_quote(opts.path), "", "[sandbox]",
     "mounts = " + toml_strings(mounts)]
    + line_when(list.len(opts.allow_net) > 0, "network = " + toml_strings(opts.allow_net))
    + line_when(opts.read_policy == "strict", "read-policy = \"strict\"")
    + line_when(list.len(opts.env_pass) > 0, "env-pass = " + toml_strings(opts.env_pass))
    + line_when(list.len(opts.allow_unix) > 0, "unix = " + toml_strings(opts.allow_unix))
    + line_when(list.len(opts.allow_bind) > 0, "bind = " + toml_strings(opts.allow_bind))
    + line_when(opts.timeout > 0, "timeout = " + int.to_string(opts.timeout))
    + line_when(opts.max_cpu > 0, "max-cpu = " + int.to_string(opts.max_cpu))
    + line_when(opts.max_procs > 0, "max-procs = " + int.to_string(opts.max_procs))
    + line_when(opts.max_file_size > 0, "max-file-size = " + int.to_string(opts.max_file_size))
    + line_when(opts.max_memory_mb > 0, "max-memory-mb = " + int.to_string(opts.max_memory_mb))
    + line_when(opts.profile != "", "profile = " + toml_quote(opts.profile))
    + (if proxy_on then ["", "[proxy]"] else [])
    + line_when(list.len(opts.proxy_allow) > 0, "allow = " + toml_strings(opts.proxy_allow))
    + line_when(list.len(opts.proxy_deny) > 0, "deny = " + toml_strings(opts.proxy_deny))
    + line_when(opts.proxy_audit != "", "audit = " + toml_quote(opts.proxy_audit))
    + line_when(has_env, "\n# -e values and secrets were not saved; add [env] and [secrets] yourself")
  string.join(lines, "\n") + "\n"
}
