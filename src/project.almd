// Project: porta.toml workflows (up, init)

import fs
import self.cli
import self.config
import self.engine

// Runs the project's command and returns its exit code; a WASM run that
// finishes is exit 0.
effect fn porta_up(extra_args: List[String]) -> Result[Int, String] = {
  let config_path = if fs.exists("porta.toml") then "porta.toml" else ".porta.toml"
  if not fs.exists(config_path) then
    err("no porta.toml in this directory; run 'porta init native <command>' to create one")
  else {
    let cfg = config.load_porta_config(config_path)!
    let env_list = cfg.env_vars
    let secret_list = cfg.secrets
    let all_args = cfg.args + extra_args

    if cfg.runtime_type == "native" then {
      let opts: cli.Options = {
        ...cli.default_options(),
        path: cfg.command,
        env_vars: env_list,
        secrets: secret_list,
        preopen_dirs: cfg.mounts,
        allow_net: cfg.network,
        proxy_allow: cfg.proxy_allow,
        proxy_deny: cfg.proxy_deny,
        proxy_audit: cfg.proxy_audit,
        env_pass: cfg.env_pass,
        allow_unix: cfg.allow_unix,
        allow_bind: cfg.allow_bind,
        timeout: cfg.timeout,
        max_cpu: cfg.max_cpu,
        max_procs: cfg.max_procs,
        max_file_size: cfg.max_file_size,
        wasm_args: all_args,
      }
      engine.run_native(opts)
    }
    else {
      // WASM runtime
      let wasm_path = cfg.wasm_path
      let opts: cli.Options = {
        ...cli.default_options(),
        path: wasm_path,
        entry: cfg.entry,
        step_limit: cfg.step_limit,
        max_memory_pages: cfg.max_memory,
        restart: cfg.restart,
        profile: cfg.profile,
        env_vars: env_list,
        secrets: secret_list,
        preopen_dirs: cfg.mounts,
        wasm_args: all_args,
      }
      engine.run_wasm(opts)!
      ok(0)
    }
  }
}

effect fn porta_init(runtime_type: String, command: String) -> Result[Unit, String] = {
  if fs.exists("porta.toml") then {
    println("porta.toml already exists.")
    ok(())
  }
  else {
    let content = if runtime_type == "native" then config.generate_native_toml(command)
      else config.generate_wasm_toml(command)
    fs.write("porta.toml", content)!
    println("Created porta.toml")
    println("")
    println("Edit porta.toml to configure your sandbox, then run:")
    println("  porta up")
    ok(())
  }
}
