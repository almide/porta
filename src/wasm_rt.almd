import value
// Wasmtime bridge + pure Almide system functions

import process
import json

// --- Wasmtime (must stay in Rust) ---

@extern(rs, "wasmtime_bridge", "wt_create")
fn wt_create(wasm_path: String, fuel: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_stdin")
fn wt_set_stdin(handle: Int, data: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_tool_stdin")
fn wt_set_tool_stdin(handle: Int, tool_name: String, args_json: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_args")
fn wt_set_args(handle: Int, args_json: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_env")
fn wt_set_env(handle: Int, key: String, value: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_run")
fn wt_run(handle: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_get_stdout")
fn wt_get_stdout(handle: Int) -> String

@extern(rs, "wasmtime_bridge", "wt_get_stderr")
fn wt_get_stderr(handle: Int) -> String

@extern(rs, "wasmtime_bridge", "wt_get_fuel_consumed")
fn wt_get_fuel_consumed(handle: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_get_exit_code")
fn wt_get_exit_code(handle: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_max_memory")
fn wt_set_max_memory(handle: Int, pages: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_set_entry")
fn wt_set_entry(handle: Int, name: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_preopen_dir")
fn wt_preopen_dir(handle: Int, host_path: String, guest_path: String) -> Int

@extern(rs, "wasmtime_bridge", "wt_destroy")
fn wt_destroy(handle: Int) -> Int

@extern(rs, "wasmtime_bridge", "wt_inspect")
fn wt_inspect(wasm_path: String) -> String

// The command, its arguments and its whole policy travel as one request
// document; see dispatch.exec_request_json for the shape.
@extern(rs, "wasmtime_bridge", "wt_exec_replace")
fn wt_exec_replace(request_json: String) -> String

// Runs the command with porta's own stdio and waits. Returns
// {"exit_code":N}, or {"error":"…"} when the run was refused before it began.
@extern(rs, "wasmtime_bridge", "wt_exec_supervised")
fn wt_exec_supervised(request_json: String) -> String

// The copy of porta `--why` starts under strace on Linux: applies the
// request to itself and becomes the command; returns only why it could not.
@extern(rs, "wasmtime_bridge", "wt_exec_inner")
fn wt_exec_inner(request_json: String) -> String

// What changed since a --snapshot run (the latest when id is ""), and with
// apply, each mount put back.
@extern(rs, "wasmtime_bridge", "wt_rollback")
fn wt_rollback(id: String, apply: Bool) -> String

// A ready-made porta.toml for a coding agent, or "" when there is none.
@extern(rs, "wasmtime_bridge", "wt_recipe")
fn wt_recipe(name: String) -> String

@extern(rs, "wasmtime_bridge", "wt_recipe_names")
fn wt_recipe_names() -> String

// The policy a request would apply, in words, without applying it.
@extern(rs, "wasmtime_bridge", "wt_sandbox_explain")
fn wt_sandbox_explain(request_json: String) -> String

// The same policy as one JSON object, for tooling and CI.
@extern(rs, "wasmtime_bridge", "wt_sandbox_explain_json")
fn wt_sandbox_explain_json(request_json: String) -> String

// What this host can enforce, and what porta will refuse here.
@extern(rs, "wasmtime_bridge", "wt_sandbox_check")
fn wt_sandbox_check() -> String

// The same host report as one JSON object.
@extern(rs, "wasmtime_bridge", "wt_sandbox_check_json")
fn wt_sandbox_check_json() -> String

@extern(rs, "wasmtime_bridge", "wt_proxy_start")
fn wt_proxy_start(allow_json: String, deny_json: String, audit_path: String) -> String

@extern(rs, "wasmtime_bridge", "wt_proxy_stop")
fn wt_proxy_stop(handle: Int) -> Int

// HTTP transport shares URL parsing with policy checks and never follows redirects.
@extern(rs, "wasmtime_bridge", "wt_http_request")
fn native_http_request(method: String, url: String, headers_json: String, body: String) -> String

effect fn wt_http_request(method: String, url: String, headers_json: String, body: String) -> Result[String, String] =
  ok(native_http_request(method, url, headers_json, body))

@extern(rs, "wasmtime_bridge", "wt_is_host_allowed")
fn wt_is_host_allowed(url: String, allowed_json: String) -> Bool

// --- exec (pure Almide) ---

effect fn wt_exec_command(cmd: String, args_json: String, cwd: String) -> Result[String, String] = {
  let args = value.as_array(json.parse(args_json) ?? value.array([])) ?? [] |> list.filter_map((v) => match value.as_string(v) { ok(s) => some(s), err(_) => none })
  let result = process.exec(cmd, args)
  match result {
    ok(stdout) => ok("{\"exit_code\":0,\"stdout\":" + json.stringify(value.str(stdout)) + ",\"stderr\":\"\"}"),
    err(e) => ok("{\"error\":" + json.stringify(value.str(e)) + "}"),
  }
}

// --- Sandboxed exec (pure Almide) ---

@extern(rs, "wasmtime_bridge", "wt_exec_sandboxed")
fn native_exec_sandboxed(request_json: String) -> String

effect fn wt_exec_sandboxed(request_json: String) -> Result[String, String] =
  ok(native_exec_sandboxed(request_json))

// Keep MCP and native execution on the same policy implementation.
@extern(rs, "wasmtime_bridge", "wt_sandbox_profile")
fn native_sandbox_profile(dirs_json: String, net_json: String, read_policy: String) -> String

fn build_sandbox_profile(allowed_dirs: List[String], allowed_net: List[String], read_policy: String) -> String =
  native_sandbox_profile(
    json.stringify(value.array(allowed_dirs |> list.map(value.str))),
    json.stringify(value.array(allowed_net |> list.map(value.str))),
    read_policy)

// --- Process management (pure Almide) ---

fn wt_home_dir() -> String = process.env("HOME") ?? "/tmp"

fn wt_getpid() -> Int = process.pid()

effect fn wt_kill(pid: Int, signal: Int) -> Result[Int, String] =
  match process.kill(pid, signal) { ok(_) => ok(0), err(e) => ok(-1) }

effect fn wt_spawn(cmd: String, args_json: String) -> Result[Int, String] = {
  let args = value.as_array(json.parse(args_json) ?? value.array([])) ?? [] |> list.filter_map((v) => match value.as_string(v) { ok(s) => some(s), err(_) => none })
  match process.spawn(cmd, args) { ok(pid) => ok(pid), err(_) => ok(-1) }
}

@extern(rs, "wasmtime_bridge", "wt_parse_toml")
fn wt_parse_toml(content: String) -> String
