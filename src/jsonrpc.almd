import value
// MCP stdio uses one UTF-8 JSON-RPC message per line.

import json
import io

type JsonRpcRequest = {
  id: Value,
  method: String,
  params: Value,
}

fn make_response(id: Value, result: Value) -> String = {
  let resp = value.object([
    ("jsonrpc", value.string("2.0")),
    ("id", id),
    ("result", result),
  ])
  json.stringify(resp)
}

fn make_error_response(id: Value, code: Int, message: String) -> String = {
  let resp = value.object([
    ("jsonrpc", value.string("2.0")),
    ("id", id),
    ("error", value.object([
      ("code", value.int(code)),
      ("message", value.string(message)),
    ])),
  ])
  json.stringify(resp)
}

fn encode_message(msg: String) -> String = msg + "\n"

effect fn write_message(msg: String) -> Result[Unit, String] = {
  io.print(encode_message(msg))
  ok(())
}

effect fn read_message() -> Result[Option[JsonRpcRequest], String] = {
  let line = io.read_line() ?? ""
  if string.len(line) == 0 then ok(none)
  else parse_and_wrap(line)
}

effect fn parse_and_wrap(body: String) -> Result[Option[JsonRpcRequest], String] = {
  let parsed = json.parse(body)!
  let id = value.get(parsed, "id") ?? value.null()
  let method = value.get_string(parsed, "method") ?? ""
  let params = value.get(parsed, "params") ?? value.object([])
  ok(some({id: id, method: method, params: params}))
}
