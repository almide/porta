// Capability-based Sandbox Enforcement
// Deny-by-default: all WASI access requires explicit capability grants.

import self.wasm_imports

type Capability =
  | CapIO
  | CapFS
  | CapFSWrite
  | CapProcess
  | CapEnv
  | CapClock
  | CapRandom
  | CapNet
  | CapExec

type CapabilitySet = {
  caps: List[Capability],
}

// --- Parsing ---

fn parse_capability(s: String) -> Option[Capability] =
  match s {
    "io" => some(CapIO),
    "fs" => some(CapFS),
    "fs.write" => some(CapFSWrite),
    "process" => some(CapProcess),
    "env" => some(CapEnv),
    "clock" => some(CapClock),
    "random" => some(CapRandom),
    "net" => some(CapNet),
    "exec" => some(CapExec),
    _ => none,
  }

fn from_manifest(caps: List[String]) -> CapabilitySet = {
  caps: caps |> list.filter_map(parse_capability),
}

// --- Capability matching ---

fn cap_eq(a: Capability, b: Capability) -> Bool =
  match (a, b) {
    (CapIO, CapIO) => true,
    (CapFS, CapFS) => true,
    (CapFSWrite, CapFSWrite) => true,
    (CapProcess, CapProcess) => true,
    (CapEnv, CapEnv) => true,
    (CapClock, CapClock) => true,
    (CapRandom, CapRandom) => true,
    (CapNet, CapNet) => true,
    (CapExec, CapExec) => true,
    _ => false,
  }

fn has_capability(set: CapabilitySet, cap: Capability) -> Bool =
  set.caps |> list.any((c) => cap_eq(c, cap))

fn cap_name(cap: Capability) -> String =
  match cap {
    CapIO => "io",
    CapFS => "fs",
    CapFSWrite => "fs.write",
    CapProcess => "process",
    CapEnv => "env",
    CapClock => "clock",
    CapRandom => "random",
    CapNet => "net",
    CapExec => "exec",
  }

// --- WASI function → required capability ---

fn required_capability(wasi_name: String) -> Option[Capability] =
  match wasi_name {
    // IO
    "fd_write" => some(CapIO),
    "fd_read" => some(CapIO),
    "fd_close" => some(CapIO),
    "fd_seek" => some(CapIO),
    // FS read
    "path_open" => some(CapFS),
    "fd_filestat_get" => some(CapFS),
    "path_filestat_get" => some(CapFS),
    "fd_readdir" => some(CapFS),
    "fd_prestat_get" => some(CapFS),
    "fd_prestat_dir_name" => some(CapFS),
    // FS write
    "path_create_directory" => some(CapFSWrite),
    "path_rename" => some(CapFSWrite),
    "path_unlink_file" => some(CapFSWrite),
    "path_remove_directory" => some(CapFSWrite),
    // Process
    "proc_exit" => some(CapProcess),
    "args_sizes_get" => some(CapProcess),
    "args_get" => some(CapProcess),
    // Env
    "environ_sizes_get" => some(CapEnv),
    "environ_get" => some(CapEnv),
    // Clock
    "clock_time_get" => some(CapClock),
    // Random
    "random_get" => some(CapRandom),
    _ => none,
  }

// --- WASI 0.2 interface → required capability ---
//
// A component imports interfaces, not functions: `wasi:cli/stdout@0.2.3` is
// one import. The version is dropped before matching, and an interface this
// table does not know is refused rather than waved through. Filesystem
// interfaces carry reads and writes in one, so they ask for `fs` and
// `fs.write` both.

fn interface_name(imported: String) -> String =
  list.get(string.split(imported, "@"), 0) ?? imported

fn required_interface_capabilities(iface: String) -> Option[List[Capability]] =
  if string.starts_with(iface, "wasi:sockets/") or string.starts_with(iface, "wasi:http/") then some([CapNet])
  else if string.starts_with(iface, "wasi:filesystem/") then some([CapFS, CapFSWrite])
  else if string.starts_with(iface, "wasi:clocks/") then some([CapClock])
  else if string.starts_with(iface, "wasi:random/") then some([CapRandom])
  else if string.starts_with(iface, "wasi:io/") then some([CapIO])
  else match iface {
    "wasi:cli/stdin" => some([CapIO]),
    "wasi:cli/stdout" => some([CapIO]),
    "wasi:cli/stderr" => some([CapIO]),
    "wasi:cli/types" => some([CapIO]),
    "wasi:cli/terminal-input" => some([CapIO]),
    "wasi:cli/terminal-output" => some([CapIO]),
    "wasi:cli/terminal-stdin" => some([CapIO]),
    "wasi:cli/terminal-stdout" => some([CapIO]),
    "wasi:cli/terminal-stderr" => some([CapIO]),
    "wasi:cli/exit" => some([CapProcess]),
    "wasi:cli/environment" => some([CapProcess, CapEnv]),
    _ => none,
  }

fn check_interface(set: CapabilitySet, imported: String) -> Result[Unit, String] =
  match required_interface_capabilities(interface_name(imported)) {
    none => err("unsupported host import: ${imported}; porta knows the wasi:* interfaces only"),
    some(caps) =>
      match caps |> list.find((cap) => not has_capability(set, cap)) {
        none => ok(()),
        some(cap) => err("import validation failed: ${imported} — capability denied: requires '${cap_name(cap)}'"),
      }
  }

// --- Runtime check ---

fn check_wasi_call(set: CapabilitySet, wasi_name: String) -> Result[Unit, String] =
  match required_capability(wasi_name) {
    none => ok(()),
    some(cap) =>
      if has_capability(set, cap) then ok(())
      else err("capability denied: '${wasi_name}' requires '${cap_name(cap)}'"),
  }

// --- Import validation (module load time) ---

fn validate_imports(imports: List[wasm_imports.Import], set: CapabilitySet) -> Result[Unit, String] =
  validate_imports_acc(imports, set, 0)

fn validate_imports_acc(imports: List[wasm_imports.Import], set: CapabilitySet, idx: Int) -> Result[Unit, String] =
  if idx >= list.len(imports) then ok(())
  else match list.get(imports, idx) {
    none => ok(()),
    some(imp) =>
      if imp.mod_name == "wasi_snapshot_preview1" then
        match check_wasi_call(set, imp.name) {
          ok(_) => validate_imports_acc(imports, set, idx + 1),
          err(msg) => err("import validation failed: ${imp.name} — ${msg}"),
        }
      else if string.starts_with(imp.mod_name, "wasi:") then
        match check_interface(set, imp.mod_name) {
          ok(_) => validate_imports_acc(imports, set, idx + 1),
          err(msg) => err(msg),
        }
      else err("unsupported host import: ${imp.mod_name}.${imp.name}; use MCP tools"),
  }

// --- Built-in profiles ---

fn profile_ai_agent() -> CapabilitySet = {
  caps: [CapIO, CapProcess],
}

fn profile_worker() -> CapabilitySet = {
  caps: [CapIO, CapProcess, CapClock, CapRandom],
}

fn profile_full() -> CapabilitySet = {
  caps: [CapIO, CapFS, CapFSWrite, CapProcess, CapEnv, CapClock, CapRandom, CapNet, CapExec],
}

fn empty() -> CapabilitySet = {
  caps: [],
}
