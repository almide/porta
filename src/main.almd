// Porta — WASM agent MCP bridge

import process
import self.cli
import self.help
import self.engine
import self.ops
import self.build
import self.project
import self.agent
import self.util
import self.wasm_rt

fn has_help_flag(args: List[String]) -> Bool =
  args |> list.any((a) => a == "--help" or a == "-h")

// A command that acts on a target. `--help`, or no target at all, prints that
// command's help and returns nothing to act on.
effect fn target_options(args: List[String], topic: String) -> Result[Option[cli.Options], String] =
  if has_help_flag(args) then { help.print_help(topic); ok(none) }
  else {
    let opts = cli.parse_options(args, 2, cli.default_options())!
    if opts.path == "" then { help.print_help(topic); ok(none) }
    else ok(some(opts))
  }

// How a native run ends, as a shell sees it. The command's own exit code is
// passed through untouched. A run porta refused before it began exits with a
// code of porta's own, so a script can tell "the command failed" from "the
// command never ran": 127 when the command does not exist, 126 when it exists
// but the policy leaves it unrunnable, 125 for every other refusal.
effect fn finish(outcome: Result[Int, String]) -> Result[Unit, String] =
  match outcome {
    ok(code) => {
      if code != 0 then process.exit(code) else ()
      ok(())
    },
    err(reason) => {
      eprintln("Error: ${reason}")
      process.exit(refusal_code(reason))
      ok(())
    },
  }

fn refusal_code(reason: String) -> Int =
  if string.contains(reason, "command not found") then 127
  else if string.contains(reason, "cannot be started") or string.contains(reason, "cannot start the command") then 126
  else 125

// porta ps/stop/kill/logs/rm all name one instance and say the same thing
// when it is missing.
effect fn instance_id(args: List[String], command: String) -> Option[String] = {
  let id = list.get(args, 2) ?? ""
  if id == "" then { println("usage: porta ${command} <instance-id>"); none }
  else some(id)
}

effect fn main() -> Result[Unit, String] = {
  let args = process.args()
  let cmd = list.get(args, 1) ?? "help"

  match cmd {
    "--version" => {
      println("porta ${util.version()}")
      ok(())
    },
    "--help" => {
      help.print_help("")
      ok(())
    },
    "__sandboxed" => {
      eprintln("Error: ${wasm_rt.wt_exec_inner(list.get(args, 2) ?? "")}")
      process.exit(125)
      ok(())
    },
    "agent-journal" => agent.journal_info(list.drop(args, 2)),
    "agent-check" => agent.inspect_config(list.drop(args, 2)),
    "agent" => agent.command(list.drop(args, 2), "run"),
    "agent-resume" => agent.command(list.drop(args, 2), "resume"),
    "agent-replay" => agent.command(list.drop(args, 2), "replay"),
    "serve" => match target_options(args, "serve")! {
      none => ok(()),
      some(opts) => engine.serve(opts),
    },
    "run" => match target_options(args, "run")! {
      none => ok(()),
      some(opts) =>
        if string.ends_with(opts.path, ".wasm") then engine.run_wasm(opts)
        else finish(engine.run_native(opts)),
    },
    "up" => {
      let rest = list.drop(args, 2)
      let extra_args = if list.get(rest, 0) ?? "" == "--" then list.drop(rest, 1) else rest
      finish(project.porta_up(extra_args))
    },
    "explain" => match target_options(args, "explain")! {
      none => ok(()),
      some(opts) => engine.explain_native(opts),
    },
    "check" => {
      let want_json = list.drop(args, 2) |> list.any((a) => a == "--json")
      println(if want_json then wasm_rt.wt_sandbox_check_json() else wasm_rt.wt_sandbox_check())
      ok(())
    },
    "init" => {
      let runtime_type = list.get(args, 2) ?? "native"
      let command = list.get(args, 3) ?? ""
      let recipe = wasm_rt.wt_recipe(runtime_type)
      if recipe != "" then project.porta_init_recipe(runtime_type, recipe)
      else if command == "" then { help.print_help("init"); ok(()) }
      else project.porta_init(runtime_type, command)
    },
    // Alias: porta run-native is equivalent to porta run <non-wasm>
    "run-native" => match target_options(args, "run")! {
      none => ok(()),
      some(opts) => finish(engine.run_native(opts)),
    },
    "inspect" => match target_options(args, "inspect")! {
      none => ok(()),
      some(opts) => engine.inspect(opts.path),
    },
    "validate" => match target_options(args, "validate")! {
      none => ok(()),
      some(opts) => engine.validate(opts),
    },
    "build" => match target_options(args, "build")! {
      none => ok(()),
      some(opts) => build.build_package(opts),
    },
    "help" => {
      let topic = list.get(args, 2) ?? ""
      help.print_help(topic)
      ok(())
    },
    "ps" => {
      ops.list_instances()
    },
    "stop" => match instance_id(args, "stop")! {
      none => ok(()),
      some(id) => ops.signal_instance(id, 15),
    },
    "kill" => match instance_id(args, "kill")! {
      none => ok(()),
      some(id) => ops.signal_instance(id, 9),
    },
    "logs" => match instance_id(args, "logs")! {
      none => ok(()),
      some(id) => ops.show_logs(id),
    },
    "rm" => match instance_id(args, "rm")! {
      none => ok(()),
      some(id) => ops.remove_instance(id),
    },
    "version" => {
      println("porta ${util.version()}")
      ok(())
    },
    _ => err("unknown command: ${cmd}; run 'porta help' for usage"),
  }
}
