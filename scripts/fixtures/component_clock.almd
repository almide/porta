// Built with `--target wasm --component`: a WASI 0.2 component that reads the
// wall clock, so it really imports wasi:clocks/wall-clock. The compiler imports
// only the interfaces a program uses, so component_hello no longer carries the
// clock; the integration suite runs this one under `porta run --profile
// ai-agent` to prove a component interface the profile does not grant is
// refused by name.
effect fn main() -> Unit = {
  let started = datetime.now()
  if started < 0 then println("the wall clock reads before 1970") else println("clock read")
}
